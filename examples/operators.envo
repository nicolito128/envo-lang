program {} {
    # Addition, subtraction, multiplication, division, remainder
    ex0 {} { 1+2, 1-3, 4*2, 10/5, 3%1 }
    # Equal, not equal, greater or eql, greater, less, less or eql, not, and, or
    ex1 {} { 1 == 2, 9 != 8, 5 >= 5, 4 > 7, 1 < 100, 1 <= 1, !false, true && false, false || true }
    # Unary operators (-, +)
    ex2 {} { -{1, -2, 3, -(-(-5))}, +2 }

    {ex0{}, ex1{}, ex2{}}
}

program{}